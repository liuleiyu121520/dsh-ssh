{
  "name": "dsh-ssh-terminal",
  "version": "0.3.1",
  "type": "module",
  "description": "在 DeepSeek Harness 启动台里开一个 SSH 远程终端：xterm 面板 + 有界滚动缓冲 + SSE 字节流",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "terminal",
    "xterm"
  ],
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "dsh-launchpad"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test --test-force-exit \"tests/**/*.test.js\"",
    "test:real": "node tests/real-host.smoke.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "crc-32": "^1.2.2",
    "ssh2": "1.17.0",
    "zmodem.js": "^0.1.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "esbuild": "^0.24.0"
  }
}
